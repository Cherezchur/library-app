<%- include('../layouts/layout-start', {title: title}) %>
<%- include('../layouts/menu', { itemName: book.title, id: book._id}) %>

<h1><%= title %></h1>

<div class="collumns">
    <div class="col-sm-8">
        <div class="card">
            <div class="card-body">

                <h5 class="card-title"><%= book.title %></h5>
                <h5 class="card-title"><%= book.authors %></h5>
                <p class="card-text"><%= book.desc %></p>

                <div class="text-right">
                    <a class="btn btn-sm btn-primary" href="/books/update/<%= book.id %>">
                        <i class="fa fa-pencil" aria-hidden="true"></i>
                    </a>
                    <form action="/books/delete/<%= book.id %>" method="POST" class="d-inline">
                        <button class="btn btn-sm btn-danger">
                            <i class="fa fa-trash" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="col-4 mt-4">
        <h3>Что вы думаете о данной книге?</h3>
        <div class="form-group">
            <label for="text">message</label>
            <textarea
                    placeholder="message"
                    class="form-control"
                    id="comment"
            ></textarea>
        </div>
        <button type="submit" id="send-room" class="btn btn-primary">here</button>
    </div>

    <div class="col-4 mt-4">
        <h3>Мнения о книге</h3>
        <div id="list" class="list-group">
            <% comments.forEach((comment) => { %>
                <div class="list-group-item list-group-item-action">
                    <p class="mb-1"><%= comment.comment %></p>
                    <span class="mb-1"><%= comment.date %></span>
                </div>
            <% }) %>
        </div>
    </div>
</div>

<script>
    const roomName = location.pathname.split('/').pop();
    const socket = io();
    
    const coomentList = document.querySelector('#list');
    const inputText = document.querySelector('#comment');
    const sendRoom = document.querySelector('#send-room');

    function setComment(msg) {
        const item = document.createElement('div');
        item.className = 'list-group-item list-group-item-action';

        const p = document.createElement('p');
        p.className = 'mb-1';
        p.textContent = msg.comment;

        const span = document.createElement('span');
        span.className = 'mb-1';
        span.textContent = new Date().toLocaleString();

        item.appendChild(p);
        item.appendChild(span);
        coomentList.prepend(item);
    };

    socket.on('message-to-room', (msg) => setComment(msg));

    sendRoom.addEventListener('click', () => {
        socket.emit('message-to-room', {
            comment: inputText.value,
            bookId: roomName
        })
    })
</script>

<%- include('../layouts/layout-end') %>